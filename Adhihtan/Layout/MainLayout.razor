@inherits LayoutComponentBase
@implements IDisposable
@inject AppStateService AppState
@inject BrowserStorage BrowserStorage

<div class="app-shell @ThemeClass @BackgroundClass">
    <a class="skip-link"
       href="#main-content"
       @onclick="FocusMainContentAsync"
       @onclick:preventDefault="true">ပင်မအကြောင်းအရာသို့ ကျော်သွားမည်</a>
    @if (!AppState.IsInitialized)
    {
        <main id="main-content"
              class="in-app-loading"
              role="status"
              aria-live="polite"
              aria-atomic="true"
              aria-busy="true"
              tabindex="-1">
            <div class="loading-emblem" aria-hidden="true"><AppIcon Name="counter" /></div>
            <strong>အဓိဋ္ဌာန်</strong>
            <span>အချက်အလက်များ ပြင်ဆင်နေပါသည်…</span>
        </main>
    }
    else
    {
        <header class="desktop-topbar">
            <div>
                <span>မင်္ဂလာပါ</span>
                <strong>အဓိဋ္ဌာန်</strong>
            </div>
            <div class="desktop-topbar-actions">
                <span class="desktop-date"><AppIcon Name="calendar" /> @BurmeseDateFormatter.Long(DateTime.Today)</span>
                <NavLink class="desktop-counter-link" href="counter" aria-label="ပုတီးစိပ်ရန်"><AppIcon Name="counter" /></NavLink>
            </div>
        </header>
        <main id="main-content" class="app-content" tabindex="-1">
            @Body
        </main>
        <BottomNav />
    }
</div>

@code {
    private string ThemeClass => AppState.State.Settings.HighContrast
        ? AppState.State.Settings.IsDarkMode ? "theme-high-contrast-dark" : "theme-high-contrast-light"
        : AppState.State.Settings.IsDarkMode ? "theme-dark" : "theme-light";

    private string BackgroundClass => $"season-{AppState.State.Settings.BackgroundStyle}";

    protected override async Task OnInitializedAsync()
    {
        AppState.Changed += HandleStateChanged;
        await AppState.InitializeAsync();
    }

    private void HandleStateChanged() => InvokeAsync(StateHasChanged);

    private async Task FocusMainContentAsync() => await BrowserStorage.FocusElementAsync("main-content");

    public void Dispose() => AppState.Changed -= HandleStateChanged;
}
